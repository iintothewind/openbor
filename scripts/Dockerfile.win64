# OpenBOR 6392 - Windows x64 交叉构建镜像
#
# 内含 x86_64-w64-mingw32 交叉工具链 + 全套**预编译**的 64 位第三方静态库
# sysroot（/opt/win64sysroot）。烘 sysroot 是为了让 OpenBOR 本体编译成为镜像
# 里唯一要做的事：CI/本地 pull 后直接出 PE32+，不必每次发布都从源码重编
# zlib/SDL2/SDL2_gfx/libpng/libogg/libvorbis/libvpx（那是原 win-x64 job 里
# 4 分钟耗时的主要来源）。
#
# 第三方库版本与构建方式全部固化在 scripts/xbuild-win64-libs.sh（锁上游 tag，
# 可复现），镜像与本地兜底路径共用同一份脚本，避免两处实现漂移。
#
# build:  以 scripts/ 为 build context（本仓库 .git 超过 1.3 GB，用仓库根做
#         context 会把整个 .git 传给 daemon；本镜像只需一个脚本）：
#           docker build -f scripts/Dockerfile.win64 -t obor-build-win64:6392 scripts
# 使用:   docker run --rm -v "$PWD":/src -w /src obor-build-win64:6392 \
#           bash -c 'git config --global --add safe.directory /src && \
#                    bash scripts/build-win64-docker.sh'
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
# 第三方库源全部是公开仓库；关掉交互式凭据提示，认证失败直接报错而不是挂住
ENV GIT_TERMINAL_PROMPT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential autoconf automake libtool pkg-config \
      nasm yasm perl make git curl ca-certificates file zlib1g-dev \
      gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

# 第三方库交叉编译脚本（同时供 build-win64-docker.sh 兜底调用）
# 注意：build context 是 scripts/，故 COPY 源路径相对该目录（不带 scripts/ 前缀）
COPY xbuild-win64-libs.sh /usr/local/share/openbor/xbuild-win64-libs.sh
RUN chmod +x /usr/local/share/openbor/xbuild-win64-libs.sh \
    && WINSDK=/opt/win64sysroot bash /usr/local/share/openbor/xbuild-win64-libs.sh

# build-win64-docker.sh 读 WINSDK 作为 SDKPATH；镜像内已预置 -> 跳过现场重编
ENV WINSDK=/opt/win64sysroot

WORKDIR /src
